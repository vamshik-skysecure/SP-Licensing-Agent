WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_SELLER_ALLOWLIST=
# Public access must be explicitly enabled. Meta signature verification remains mandatory.
WHATSAPP_ALLOW_ALL_SELLERS=false
WHATSAPP_VALIDATE_CREDENTIALS_ON_STARTUP=true

# One high-level runtime switch:
# - local_demo: local workbook + in-memory sessions + direct webhook handling
# - production: Azure Blob workbook/sessions + durable Blob webhook inbox
# Leave unset only when using the advanced individual settings below.
RUNTIME_PROFILE=local_demo

# One authoritative storage switch:
# - local: checked-in workbook + in-memory sessions
# - azure_blob: Blob workbook + Blob workflow sessions
STORAGE_MODE=local
WORKFLOW_MODE=simple_pricing

# Advanced/backward-compatible overrides. STORAGE_MODE wins when it is set.
RATE_CARD_BACKEND=local
RATE_CARD_LOCAL_PATH=docs/microsoft_sku_v6_distributor.xlsx
RATE_CARD_SHEET_NAME=Outcome Sheet
RATE_CARD_STORAGE_ACCOUNT_URL=
RATE_CARD_STORAGE_CONNECTION_STRING=
RATE_CARD_CONTAINER_NAME=pricing-workbooks
RATE_CARD_BLOB_NAME=active/Microsoft_SKU_V6.0_Distributor.xlsx
# Approved V6 pricing column: "Expectec Disti Price to Skysecure".
SIMPLE_PRICE_BASIS=distributor_expected

# In azure_blob mode, workflow JSON uses a separate container in the same account.
WORKFLOW_STORE_BACKEND=memory
WORKFLOW_BLOB_CONTAINER_NAME=licensing-workflows
WORKFLOW_BLOB_PREFIX=sessions

# Durable ingress uses the existing workflow Blob container in production.
MESSAGE_DISPATCH_BACKEND=direct
WEBHOOK_BLOB_PREFIX=webhook-queue
WEBHOOK_BLOB_POLL_SECONDS=1
WEBHOOK_MAX_DELIVERY_COUNT=5

# Keep false in production. Use the existing App Service managed identity with the account URL.
ALLOW_CONNECTION_STRINGS_IN_PRODUCTION=false

# Natural-language routing through the standard OpenAI API and official Python SDK.
# Commands and buttons remain available when disabled for local/offline tests.
AI_INTENT_BACKEND=openai
REQUIREMENT_CAPTURE_BACKEND=openai
# Opt-in recommendation research. Web search is restricted in code to Microsoft-owned domains;
# catalogue prices remain authoritative and no researched recommendation is auto-applied.
OFFICIAL_RECOMMENDATION_BACKEND=openai_web
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_REASONING_EFFORT=none
OPENAI_VALIDATE_MODELS_ON_STARTUP=false

DEFAULT_TERM_DURATION=P1Y
DEFAULT_BILLING_PLAN=Annual
DEFAULT_CUSTOMER_SEGMENT=Commercial
DEFAULT_CURRENCY=INR
MIGRATION_SEED_PATH=config/migration_seed.json
MAX_DOCUMENT_BYTES=10485760
MAX_IMAGE_BYTES=8388608
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_SECONDS=300
ENVIRONMENT=development
PORT=8000
