WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_SELLER_ALLOWLIST=919999999999
WHATSAPP_VALIDATE_CREDENTIALS_ON_STARTUP=true

# Local development reads the checked-in workbook. Production should use azure_blob.
RATE_CARD_BACKEND=local
RATE_CARD_LOCAL_PATH=docs/blob_storage.xlsx
RATE_CARD_SHEET_NAME=Outcome Sheet
RATE_CARD_STORAGE_ACCOUNT_URL=
RATE_CARD_STORAGE_CONNECTION_STRING=
RATE_CARD_CONTAINER_NAME=pricing-workbooks
RATE_CARD_BLOB_NAME=blob_storage.xlsx

# Workflow JSON uses the same Azure Storage account as the rate-card workbook.
# A separate container lets lifecycle retention target sessions without touching pricing.
WORKFLOW_STORE_BACKEND=memory
WORKFLOW_BLOB_CONTAINER_NAME=licensing-workflows
WORKFLOW_BLOB_PREFIX=sessions

# Optional durable webhook dispatch. Production should use service_bus.
MESSAGE_DISPATCH_BACKEND=direct
SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_QUEUE_NAME=whatsapp-inbound

# Natural-language routing through the standard OpenAI API and official Python SDK.
# Commands and buttons remain available when disabled for local/offline tests.
AI_INTENT_BACKEND=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none

DEFAULT_TERM_DURATION=P1Y
DEFAULT_BILLING_PLAN=Annual
DEFAULT_CUSTOMER_SEGMENT=Commercial
DEFAULT_CURRENCY=INR
MAX_DOCUMENT_BYTES=10485760
ENVIRONMENT=development
PORT=8000
